<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="com.poplingo.poplingo.HelloController" styleClass="root">

    <VBox fx:id="pageLogin" alignment="CENTER" spacing="25.0">
        <VBox alignment="CENTER" spacing="2.0">
            <ImageView fitWidth="120" preserveRatio="true">
                <image>
                    <Image url="@images/cover_bird.png"/>
                </image>
            </ImageView>
            <Label text="Poplingo" styleClass="title-label"/>
            <Label text="找飯店trivago，學音樂poplingo" styleClass="subtitle-text"/>
        </VBox>

        <VBox alignment="CENTER" spacing="15.0" maxWidth="260">
            <TextField fx:id="loginUsernameField" promptText="請輸入帳號" styleClass="input-field" prefHeight="40"/>
            <PasswordField fx:id="loginPasswordField" promptText="請輸入密碼" styleClass="input-field" prefHeight="40"/>
            <Label fx:id="loginMessageLabel" text="" style="-fx-text-fill: #FF4B4B; -fx-font-size: 14;"/>

            <Button text="登入" onAction="#onLoginSubmit" prefHeight="45.0" prefWidth="260.0" styleClass="login-button"/>
            <Button text="註冊新帳號" onAction="#onGoToRegisterClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </VBox>

        <ImageView fitWidth="400" preserveRatio="true">
            <image>
                <Image url="@images/cover_animal.png"/>
            </image>
        </ImageView>
    </VBox>

    <VBox fx:id="pageRegister" visible="false" alignment="CENTER" spacing="25.0">
        <VBox alignment="CENTER" spacing="5.0">
            <Label text="建立新帳號" styleClass="title-label" style="-fx-font-size: 32;"/>
            <Label text="加入 Poplingo 的世界" styleClass="subtitle-text"/>
        </VBox>

        <VBox alignment="CENTER" spacing="15.0" maxWidth="260">
            <TextField fx:id="registerUsernameField" promptText="設定帳號" styleClass="input-field" prefHeight="40"/>
            <PasswordField fx:id="registerPasswordField" promptText="設定密碼" styleClass="input-field" prefHeight="40"/>
            <Label fx:id="registerMessageLabel" text="" style="-fx-text-fill: #FF4B4B; -fx-font-size: 14;"/>

            <Button text="立即註冊" onAction="#onRegisterSubmit" prefHeight="45.0" prefWidth="260.0" styleClass="login-button" style="-fx-background-color: #58CC02;"/>
            <Button text="← 返回登入" onAction="#onGoToLoginClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </VBox>
    </VBox>

    <VBox fx:id="pageMode" visible="false" alignment="CENTER" spacing="30.0">
        <Label text="請選擇模式" styleClass="title-label" style="-fx-font-size: 28;"/>
        <HBox alignment="CENTER" spacing="20">
            <Button text="📖 音樂學習" onAction="#onLearningModeClick" styleClass="login-button" prefWidth="160" prefHeight="140" style="-fx-font-size: 20;"/>
            <Button text="📝 單字複習" onAction="#onReviewModeClick" styleClass="login-button" prefWidth="160" prefHeight="140" style="-fx-font-size: 20; -fx-background-color: #58CC02;"/>
        </HBox>
        <Button text="← 返回主畫面" onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-cursor: hand; -fx-font-size: 16;"/>
    </VBox>

    <VBox fx:id="pageSelection" visible="false" alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 40 20 20 20;">
        <HBox alignment="CENTER_LEFT" maxWidth="300">
            <Button text="←" onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-font-size: 24; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="selectionTitle" text="選擇類別" styleClass="title-label" style="-fx-font-size: 28;"/>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
            <VBox fx:id="listContainer" spacing="15.0" alignment="CENTER" />
        </ScrollPane>
    </VBox>

    <VBox fx:id="pageLearn" visible="false" alignment="TOP_CENTER" spacing="15.0" style="-fx-padding: 20;">
        <HBox alignment="CENTER_LEFT">
            <Button text="←" onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-font-size: 24; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
<!--            <Label fx:id="learnTitle" text="學習中..." styleClass="subtitle-text"/>-->
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <Button fx:id="playButton" text="▶ 播放音樂" onAction="#onPlayMusicClick" styleClass="login-button" prefWidth="200" prefHeight="40" style="-fx-font-size: 16px;"/>

        <HBox alignment="CENTER" spacing="10" maxWidth="300">
            <Label fx:id="currentTimeLabel" text="00:00" style="-fx-text-fill: #7F7F9D; -fx-font-weight: bold;"/>
            <Slider fx:id="progressBar" HBox.hgrow="ALWAYS" styleClass="music-slider"/>
            <Label fx:id="totalTimeLabel" text="00:00" style="-fx-text-fill: #7F7F9D; -fx-font-weight: bold;"/>
        </HBox>

        <VBox styleClass="flashcard" maxWidth="320" spacing="8" alignment="CENTER" style="-fx-padding: 10 15 15 15;">
            <HBox alignment="CENTER_RIGHT" prefWidth="290">
                <Button fx:id="starButton" text="☆" onAction="#onStarClick" visible="false" style="-fx-background-color: transparent; -fx-text-fill: #FFD700; -fx-font-size: 22; -fx-cursor: hand; -fx-padding: 0;"/>
            </HBox>
            <Label fx:id="wordLabel" text="請點擊下方歌詞" styleClass="flashcard-word" style="-fx-font-size: 24;"/>
            <Label fx:id="phoneticLabel" text="點擊單字查詢翻譯" styleClass="flashcard-phonetic"/>
            <Label fx:id="translationLabel" text="-" styleClass="flashcard-translation"/>
            <Label fx:id="lyricLabel" text="-" styleClass="flashcard-lyric"/>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" prefHeight="260" vbarPolicy="NEVER">
            <TextFlow fx:id="lyricsTextFlow" textAlignment="CENTER" style="-fx-padding: 10;" />
        </ScrollPane>
    </VBox>

    <VBox fx:id="pageReview" visible="false" alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 20;">
        <HBox alignment="CENTER_LEFT">
            <Button text="←" onAction="#onBackClick" style="-fx-background-color: transparent; -fx-text-fill: #4A4E69; -fx-font-size: 24; -fx-cursor: hand; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="單字卡複習" styleClass="subtitle-text"/>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <Label fx:id="reviewProgressLabel" text="1 / 10" style="-fx-font-size: 16; -fx-text-fill: #7F7F9D; -fx-font-weight: bold;"/>

        <VBox styleClass="flashcard" maxWidth="320" minHeight="280" spacing="15" alignment="CENTER" onMouseClicked="#onFlipCard" style="-fx-cursor: hand;">
            <Label fx:id="reviewWordLabel" text="單字" styleClass="flashcard-word" style="-fx-font-size: 36;"/>
            <Label fx:id="reviewPhoneticLabel" text="拼音" styleClass="flashcard-phonetic" style="-fx-font-size: 20;"/>
            <Label fx:id="reviewTranslationLabel" text="翻譯" styleClass="flashcard-translation" visible="false" style="-fx-font-size: 26; -fx-text-fill: #1CB0F6;"/>
            <Label fx:id="reviewSongLabel" text="🎵 來自歌曲" styleClass="flashcard-lyric" visible="false" style="-fx-font-size: 16;"/>

            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="reviewHintLabel" text="(點擊卡片顯示答案)" style="-fx-text-fill: #CFCFCF; -fx-font-size: 14;"/>
        </VBox>

        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 0 0;">
            <Button text="← 上一個" onAction="#onPrevCardClick" styleClass="list-button" prefWidth="120" prefHeight="40"/>
            <Button text="下一個 →" onAction="#onNextCardClick" styleClass="list-button" prefWidth="120" prefHeight="40"/>
        </HBox>
    </VBox>

</StackPane>